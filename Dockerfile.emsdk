# Dockerfile for building (and serving) the Emscripten / web version of
# Asteroids, so that contributors don't need to install the Emscripten SDK
# on their host machine.
#
# The official emscripten/emsdk image bundles the full toolchain
# (emcc, emcmake, emmake, emrun) along with CMake, Python and Node.
#
# Build the image:
#   docker build -f Dockerfile.emsdk -t asteroids-emscripten .
#
# Run a web server that serves the game on http://localhost:6931
#   docker run --rm -p 6931:6931 asteroids-emscripten

# The emscripten/emsdk image is only published for linux/amd64, so we pin
# the platform explicitly. On Apple Silicon (arm64) this runs under emulation,
# which is fine for a one-off build and serving static files.
FROM --platform=linux/amd64 emscripten/emsdk:3.1.51

# Build in an isolated directory so we never clobber a native build that
# might already exist in the mounted source tree.
WORKDIR /src

# Copy the project sources into the image.
COPY . .

# Configure and build the web version. This mirrors the manual steps that
# are documented in the README:
#   emcmake cmake ..
#   emmake make
RUN rm -rf embuild \
    && mkdir embuild \
    && cd embuild \
    && emcmake cmake .. \
    && emmake make -j"$(nproc)"

# emrun serves the generated page along with the asteroids.data asset
# bundle over HTTP. --no_browser stops it trying to launch a browser
# inside the container, and binding to 0.0.0.0 makes it reachable from
# the host.
WORKDIR /src/embuild
EXPOSE 6931
CMD ["emrun", "--no_browser", "--port", "6931", "--hostname", "0.0.0.0", "index.html"]
